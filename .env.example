# -----------------------------------------------------------------------------
# School Management System - environment variables
# Copy this file to .env and fill in real values. Never commit .env.
#
# See: node_modules/next/dist/docs/01-app/02-guides/environment-variables.md
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_management?schema=public"

# Base URL of the application (used for links, redirects, etc.).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" when running in production.
NODE_ENV="development"

# Directory where private file objects are persisted (student/exam-paper
# documents). Defaults to <project>/.uploads when unset. Files are only ever
# served through authenticated route handlers — never from a public URL.
# UPLOAD_DIR=".uploads"
